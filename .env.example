# ─── Admin Panel (required to use /admin) ──────────────────────────────────────
# The password you'll type on the /admin/login page.
ADMIN_PASSWORD=change-me-to-a-strong-password

# A long random string (32+ chars) used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-min-32-chars
